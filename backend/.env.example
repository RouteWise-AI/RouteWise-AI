# AI Provider ("mock" or "bedrock")
AI_PROVIDER=mock

# AWS Bedrock Configuration (Used only when AI_PROVIDER=bedrock)
# Supported auth methods:
# 1. Official Bedrock Bearer Token: AWS_BEARER_TOKEN_BEDROCK
# 2. Standard IAM Keys: AWS_ACCESS_KEY_ID & AWS_SECRET_ACCESS_KEY
AWS_REGION=us-east-1
AWS_PROFILE=default
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5
# AWS_BEARER_TOKEN_BEDROCK=

# MCP Configuration
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
MCP_SERVER_PATH=/mcp
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional External Routing / Geocoding Services
# NOTE: RouteWise AI uses a built-in deterministic Indian logistics routing engine.
# An external API key is NOT required for standard hackathon demonstration or testing.
# Lowest-cost provider: OpenRouteService (Free tier: 2,000 req/day, no credit card required)
# Sign up: https://openrouteservice.org/dev/#/signup
GEOCODING_PROVIDER=built-in
OPENROUTESERVICE_API_KEY=
