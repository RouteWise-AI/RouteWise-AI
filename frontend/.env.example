# RouteWise AI - Frontend Environment Configuration Example

# 1. API Base URL:
# - Leave blank for Vite dev-server proxy targeting http://127.0.0.1:8001 (Recommended for single-port forwarding)
# - Set to https://<your-backend-host> if forwarding backend separately (Dual-port forwarding)
VITE_API_BASE_URL=

# 2. Primary Map Provider: Esri World Street Map (Public HTTPS, No API Key Required)
VITE_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}
VITE_MAP_ATTRIBUTION=Tiles &copy; Esri &mdash; see Esri's World Street Map attribution and usage terms