# ==============================================================================
# RouteWise AI — Production & Local Environment Configuration Template
# ==============================================================================
# Use this template to configure environment variables.
# NEVER commit real credentials, access keys, or bearer tokens to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RENDER (Backend & MCP Server Web Service Environment Variables)
# ------------------------------------------------------------------------------
# App Environment ("production" or "development")
ENVIRONMENT=production

# Python Runtime Version (Managed by Render via .python-version or env var)
PYTHON_VERSION=3.11.10

# AI Provider: "mock" (deterministic, zero cloud cost) or "bedrock" (Amazon Bedrock)
AI_PROVIDER=mock

# MCP Server Configuration
# When using unified start_production.py runner, keep defaults (127.0.0.1:8000)
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
MCP_SERVER_PATH=/mcp
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# Backend Host & Port (Render automatically sets $PORT in production)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001

# Allowed CORS Origins (Comma-separated list of origins permitted to call FastAPI)
# Example for production: https://routewise-ai.vercel.app,https://*.vercel.app
CORS_ORIGINS=https://*.vercel.app,http://localhost:5173

# Optional: Amazon Bedrock Credentials (Required ONLY when AI_PROVIDER=bedrock)
# Server-side only: never expose these to the frontend
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5
# Auth Method 1: Bedrock Bearer Token
# AWS_BEARER_TOKEN_BEDROCK=
# Auth Method 2: Standard IAM Access Keys
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=default

# Optional: External Routing / Turn-by-Turn Geocoding (Default built-in requires NO keys)
GEOCODING_PROVIDER=built-in
# OPENROUTESERVICE_API_KEY=

# ------------------------------------------------------------------------------
# 2. VERCEL (Frontend React/Vite Project Environment Variables)
# ------------------------------------------------------------------------------
# Deployed Backend API Base URL
# Set this in Vercel Project Settings -> Environment Variables
# Example: https://routewise-ai-backend.onrender.com
# (Leave empty ONLY during local development when Vite proxies /api)
VITE_API_BASE_URL=https://<your-render-backend-name>.onrender.com

# Map Provider Configuration (Default: Esri World Street Map, No API Key Required)
VITE_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}
VITE_MAP_ATTRIBUTION=Tiles &copy; Esri &mdash; see Esri's World Street Map attribution and usage terms
